diff --git a/install-jetson-jp5.sh b/install-jetson-jp5.sh
new file mode 100755
index 00000000..4ea7aa9d
--- /dev/null
+++ b/install-jetson-jp5.sh
@@ -0,0 +1,99 @@
+#!/bin/sh
+set -eu
+
+script_dir=$(
+	CDPATH=
+	cd -P "$(dirname "$0")"
+	pwd
+)
+python_bin=${PYTHON_BIN:-${HOME}/.pyenv/versions/3.10.20/bin/python}
+wheel_dir=${JETSON_WHEEL_DIR:-${HOME}/jetson}
+venv_dir=$script_dir/.venv
+torch_wheel=${TORCH_WHEEL:-$wheel_dir/torch-2.1.0a0+git7bcf7da-cp310-cp310-linux_aarch64.whl}
+torchvision_wheel=${TORCHVISION_WHEEL:-$wheel_dir/torchvision-0.16.0+fbb4cc5-cp310-cp310-linux_aarch64.whl}
+torchaudio_wheel=${TORCHAUDIO_WHEEL:-$wheel_dir/torchaudio-2.1.0+6ea1133-cp310-cp310-linux_aarch64.whl}
+torch_sha=${TORCH_WHEEL_SHA256:-1079d7eaf5e6be486a534bc1546ce355e53fa63494eab9bb72611ca48d3f9cdf}
+torchvision_sha=${TORCHVISION_WHEEL_SHA256:-0ddb4140f0827ec89349a61d47c0d6c5319c469686da501c6113b48c3faba3b1}
+torchaudio_sha=${TORCHAUDIO_WHEEL_SHA256:-00204769e28772eb12bb53a3cc33b61e8d1c7be640c44edfd23b587dff4f3566}
+xformers_sha=${XFORMERS_WHEEL_SHA256:-496de486460855325ba10afb81b560f30cddd8aa592077efa877f6d7bb884672}
+
+if [ "${XFORMERS_WHEEL+x}" = x ]; then
+	xformers_wheel=$XFORMERS_WHEEL
+else
+	set -- "$wheel_dir"/xformers-0.0.23+e1b36f7.d*-cp310-cp310-linux_aarch64.whl
+	if [ "$#" -ne 1 ] || [ ! -f "$1" ]; then
+		printf 'Expected exactly one Xavier xFormers wheel in %s\n' "$wheel_dir" >&2
+		exit 1
+	fi
+	xformers_wheel=$1
+fi
+
+verify_wheel() {
+	wheel=$1
+	expected=$2
+	if [ ! -f "$wheel" ]; then
+		printf 'Required Jetson wheel not found: %s\n' "$wheel" >&2
+		exit 1
+	fi
+	case $expected in
+	'' | *[!0-9a-f]*)
+		printf 'Invalid SHA256 for Jetson wheel: %s\n' "$wheel" >&2
+		exit 1
+		;;
+	esac
+	if [ "${#expected}" -ne 64 ]; then
+		printf 'Invalid SHA256 length for Jetson wheel: %s\n' "$wheel" >&2
+		exit 1
+	fi
+	actual=$(sha256sum "$wheel" | awk '{print $1}')
+	if [ "$actual" != "$expected" ]; then
+		printf 'Jetson wheel checksum mismatch: %s\n' "$wheel" >&2
+		exit 1
+	fi
+}
+
+export CMAKE_BUILD_PARALLEL_LEVEL=1
+export MAKEFLAGS=-j1
+export MAX_JOBS=1
+export NINJAFLAGS=-j1
+export OMP_NUM_THREADS=1
+
+verify_wheel "$torch_wheel" "$torch_sha"
+verify_wheel "$torchvision_wheel" "$torchvision_sha"
+verify_wheel "$torchaudio_wheel" "$torchaudio_sha"
+verify_wheel "$xformers_wheel" "$xformers_sha"
+
+"$python_bin" -m venv "$venv_dir"
+python=$venv_dir/bin/python
+
+"$python" -m pip install --upgrade pip "setuptools==80.9.0" wheel
+"$python" -m pip install --no-deps \
+	"$torch_wheel" \
+	"$torchvision_wheel" \
+	"$torchaudio_wheel"
+"$python" -m pip install -r "$script_dir/requirements.txt"
+"$python" -m pip install -r "$script_dir/requirements.jetson-engine.txt"
+"$python" -m pip install --no-deps horde-engine==2.15.3
+"$python" -m pip install --no-deps "$xformers_wheel"
+"$python" -m pip install --no-deps -e "$script_dir"
+
+"$python" - <<'PY'
+import importlib.metadata as metadata
+
+import torch
+import xformers
+
+assert torch.__version__ == "2.1.0a0+git7bcf7da", torch.__version__
+assert torch.version.cuda == "11.4", torch.version.cuda
+assert torch.cuda.is_available(), "PyTorch cannot access Xavier's CUDA device"
+assert torch.cuda.get_device_capability(0) == (7, 2)
+assert xformers._has_cpp_library, "xFormers CUDA extension is unavailable"
+assert metadata.version("horde-worker-regen") == "9.0.7"
+assert metadata.version("horde-engine") == "2.15.3"
+print("torch", torch.__version__)
+print("cuda", torch.version.cuda)
+print("device", torch.cuda.get_device_name(0))
+print("xformers", metadata.version("xformers"))
+print("worker", metadata.version("horde-worker-regen"))
+print("engine", metadata.version("horde-engine"))
+PY
