/* Terminal projection of @haidra-org/horde-design-system. See tui/design.py for provenance. */

Screen {
    background: $background;
    color: $foreground;
}

Header {
    background: $panel;
    color: $foreground;
}

Footer {
    background: $panel;
}

/* The level indicator shares the Footer's row rather than taking one of its own, which matters at
   the 80x24 floor where every content line is contested. */
#footer-bar {
    height: 1;
    dock: bottom;
    background: $panel;
}

/* Footer docks itself to the bottom by default, which would lift it out of this row's flow and stack
   it on top of the indicator. Releasing the dock lets the two share the row side by side. */
#footer-bar Footer {
    dock: none;
    width: 1fr;
}

#level-indicator {
    width: auto;
    min-width: 10;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
    content-align: right middle;
}

.horde-hero {
    height: auto;
    padding: 1 2;
    margin-bottom: 1;
    border: tall $primary;
    background: $panel;
}

.horde-card {
    height: auto;
    padding: 1 2;
    margin-bottom: 1;
    border: round $horde-edge;
    background: $surface;
}

.horde-card-title {
    text-style: bold;
    color: $foreground;
}

.horde-muted {
    color: $text-muted;
}

.horde-actions {
    height: auto;
    margin-top: 1;
}

.horde-actions Button {
    margin-right: 1;
    min-width: 18;
}

/* A one-line plain-language framing shown above the real widgets on the technical tabs in Simple.
   The tabs keep their own presentation; only this explanatory line is level-dependent. */
.horde-tab-intro {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
    color: $text-muted;
}

.level-simple-only, .level-operator-only, .level-developer-only {
    display: none;
}

Screen.level-simple .level-simple-only,
Screen.level-advanced .level-operator-only,
Screen.level-developer .level-operator-only,
Screen.level-developer .level-developer-only {
    display: block;
}

/* Config fields carry their risk tier as a class. Withholding them in CSS leaves the widget mounted and
   its value intact, so a field the current level does not show is still written back on save. */
Screen.level-simple .field-advanced,
Screen.level-simple .field-dangerous,
Screen.level-advanced .field-dangerous {
    display: none;
}

Screen.density-compact .horde-card {
    padding: 0 1;
    margin-bottom: 0;
}

Screen.density-compact .horde-hero {
    padding: 0 1;
    margin-bottom: 0;
}

/* At the 80x24 floor a full box border costs two rows per card, which is more than the layout can
   afford. A single left edge keeps each card visually separate for one column and no rows at all;
   dropping the border outright ran the hero and every card together into one wall of text. */
Screen.-narrow .horde-hero,
Screen.-narrow .horde-card {
    padding: 0 1;
    margin-bottom: 0;
    border: none;
}

Screen.-narrow .horde-hero {
    border-left: thick $primary;
}

Screen.-narrow .horde-card {
    border-left: solid $horde-edge;
}

Screen.-narrow #level-indicator {
    min-width: 6;
    padding: 0;
}
