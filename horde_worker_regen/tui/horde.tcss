/* Terminal projection of @haidra-org/horde-design-system. See tui/design.py for provenance. */

Screen {
    background: $background;
    color: $foreground;
}

Header {
    background: $panel;
    color: $foreground;
}

Footer {
    background: $panel;
}

/* The level indicator shares the Footer's row rather than taking one of its own, which matters at
   the 80x24 floor where every content line is contested. */
#footer-bar {
    height: 1;
    dock: bottom;
    background: $panel;
}

/* Footer docks itself to the bottom by default, which would lift it out of this row's flow and stack
   it on top of the indicator. Releasing the dock lets the two share the row side by side. */
#footer-bar Footer {
    dock: none;
    width: 1fr;
}

#level-indicator {
    width: auto;
    min-width: 10;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
    content-align: right middle;
}

.horde-hero {
    height: auto;
    padding: 1 2;
    margin-bottom: 1;
    border: tall $primary;
    background: $panel;
}

.horde-card {
    height: auto;
    padding: 1 2;
    margin-bottom: 1;
    border: round $horde-edge;
    background: $surface;
}

.horde-card-title {
    text-style: bold;
    color: $foreground;
}

.horde-muted {
    color: $text-muted;
}

.horde-actions {
    height: auto;
    margin-top: 1;
}

.horde-actions Button {
    margin-right: 1;
    min-width: 18;
}

/* A one-line plain-language framing shown above the real widgets on the technical tabs in Simple.
   The tabs keep their own presentation; only this explanatory line is level-dependent. */
.horde-tab-intro {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
    color: $text-muted;
}

.level-simple-only, .level-operator-only, .level-developer-only {
    display: none;
}

Screen.level-simple .level-simple-only,
Screen.level-advanced .level-operator-only,
Screen.level-developer .level-operator-only,
Screen.level-developer .level-developer-only {
    display: block;
}

/* Config fields carry their risk tier as a class. Withholding them in CSS leaves the widget mounted and
   its value intact, so a field the current level does not show is still written back on save. */
Screen.level-simple .field-advanced,
Screen.level-simple .field-dangerous,
Screen.level-advanced .field-dangerous {
    display: none;
}

/* A dashboard served on an address other than loopback is reachable, unauthenticated, by anyone on the
   network, who could otherwise read or replace the worker's credentials. Withholding them in CSS (as
   above) keeps the loaded values intact, so a save from such a session still writes the real key back
   rather than blanking it. */
Screen.-remote-exposed .field-secret {
    display: none;
}

Screen.density-compact .horde-card {
    padding: 0 1;
    margin-bottom: 0;
}

Screen.density-compact .horde-hero {
    padding: 0 1;
    margin-bottom: 0;
}

/* At the 80x24 floor a full box border costs two rows per card, which is more than the layout can
   afford. A single left edge keeps each card visually separate for one column and no rows at all;
   dropping the border outright ran the hero and every card together into one wall of text.
   Textual stamps one width class at a time, so the phone band has to be named alongside the narrow
   one everywhere the rule holds for both. */
Screen.-narrow .horde-hero, Screen.-phone .horde-hero,
Screen.-narrow .horde-card, Screen.-phone .horde-card {
    padding: 0 1;
    margin-bottom: 0;
    border: none;
}

Screen.-narrow .horde-hero, Screen.-phone .horde-hero {
    border-left: thick $primary;
}

Screen.-narrow .horde-card, Screen.-phone .horde-card {
    border-left: solid $horde-edge;
}

Screen.-narrow #level-indicator {
    min-width: 6;
    padding: 0;
}

/* Below the terminal floor, which is what a phone browser gets. Anything laid out side by side has to
   stack: an action row of two buttons already exceeds the width, and a label beside its input leaves
   the input too narrow to read what has been typed into it. */
Screen.-phone .horde-actions {
    layout: vertical;
}

Screen.-phone Button {
    height: 4;
}

Screen.-phone Input,
Screen.-phone Select {
    height: 4;
}

Screen.-phone CollapsibleTitle,
Screen.-phone SelectionList > .option-list--option {
    padding: 1;
}

/* Action rows sized for a desktop must not silently paint controls beyond a phone viewport. The
   marker is shared by every tab-level toolbar so new actions inherit the same safe stacking rule. */
Screen.-phone .responsive-toolbar {
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-rows: 4;
    grid-gutter: 0 1;
    height: auto;
    padding: 0;
}

Screen.-phone .responsive-toolbar > Button,
Screen.-phone .responsive-toolbar > Input,
Screen.-phone .responsive-toolbar > Select,
Screen.-phone .responsive-toolbar > Label {
    width: 100%;
    min-width: 0;
    margin: 0;
}

Screen.-phone .responsive-toolbar > Label {
    height: 4;
    content-align: left middle;
}

Screen.-phone .responsive-toolbar > Rule,
Screen.-phone .responsive-toolbar > #diag-controls-spacer {
    display: none;
}

Screen.-phone .horde-actions Button {
    width: 100%;
    height: 5;
    margin-right: 0;
}

/* At the fitted 10px phone font this gives every primary destination a roughly 40px-high target.
   Keeping the target tall matters more than conserving one terminal row: phone pages scroll, but a
   one-row tab is too easy to miss with a finger. */
Screen.-phone Tabs,
Screen.-phone Tab {
    height: 4;
}

Screen.-phone Tab {
    content-align: center middle;
}

Screen.-phone .config-row {
    layout: vertical;
    height: auto;
}

Screen.-phone DashboardPreferencesView .experience-row,
Screen.-phone DashboardPreferencesView .experience-choice,
Screen.-phone BenchmarkView .adv-row {
    layout: vertical;
    height: auto;
}

Screen.-phone DashboardPreferencesView .experience-row Button,
Screen.-phone DashboardPreferencesView .experience-choice Label,
Screen.-phone DashboardPreferencesView .experience-choice Select,
Screen.-phone BenchmarkView .adv-row .adv-label,
Screen.-phone BenchmarkView .adv-row .adv-input,
Screen.-phone BenchmarkView .adv-row .adv-help {
    width: 100%;
}

Screen.-phone DashboardPreferencesView .experience-choice Label,
Screen.-phone BenchmarkView .adv-row .adv-label,
Screen.-phone BenchmarkView .adv-row .adv-help {
    height: auto;
}

/* On a phone, the whole Config page owns vertical scrolling. Keeping the actions and summaries outside
   the sub-tab's scroll container pins a large preamble above every field; once the software keyboard
   reduces the row count, that preamble can consume most of the usable screen. */
Screen.-phone ConfigEditorView {
    overflow-y: auto;
}

/* The desktop keeps the Overview hero above its body scroller. On a phone that sticky block consumes too
   much of the viewport, so the page becomes the sole scroller and the hero can leave with its content. */
Screen.-phone OverviewView {
    overflow-y: auto;
}

Screen.-phone OverviewView #overview-body {
    height: auto;
    overflow-y: hidden;
}

Screen.-phone ConfigEditorView #config-actions {
    layout: vertical;
    height: auto;
}

Screen.-phone ConfigEditorView #config-actions Button {
    width: 100%;
    margin-right: 0;
}

Screen.-phone ConfigEditorView #config-actions-spacer,
Screen.-phone ConfigEditorView #config-actions-separator {
    display: none;
}

Screen.-phone ConfigEditorView #config-subtabs,
Screen.-phone ConfigEditorView .config-subtab-scroll {
    height: auto;
    overflow-y: hidden;
}

/* The level is named on the Config page and in the command palette, so the footer keeps the whole row
   for the shortcuts, which have nowhere else to appear. */
Screen.-phone #level-indicator {
    display: none;
}

/* The title/clock header duplicates information already available in the phone status line and consumes
   scarce vertical space even before the software keyboard opens. Desktop keeps the full header. */
Screen.-phone Header {
    display: none;
}

/* Phone shortcuts live in the browser dock and command palette. The terminal Footer's truncated key hints
   and Palette affordance cost a row and are harder to tap than their browser-native replacement. */
Screen.-phone Footer,
Screen.-phone #footer-bar {
    display: none;
}

/* The software keyboard and landscape orientation can leave fewer than 28 terminal rows. Let modal bodies
   themselves scroll so their final field and dismissal actions remain reachable. */

Screen.-phone.-short Tabs,
Screen.-phone.-short Tab {
    height: 3;
}

Screen.-short > Vertical {
    height: auto;
    max-height: 100%;
    overflow-y: auto;
}

Screen.-short .dialog-buttons,
Screen.-short #confirm-actions {
    layout: vertical;
    height: auto;
}

Screen.-short .dialog-buttons Button,
Screen.-short #confirm-actions Button {
    width: 100%;
    margin: 0 0 1 0;
}
